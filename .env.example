# Environment Variables

# ==========================================
# FRONTEND (Vite/React)
# ==========================================
# API URL for the backend server
VITE_API_URL=http://localhost:5000

# Google OAuth Client ID (get from https://console.cloud.google.com/)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ==========================================
# BACKEND (Flask/Python)
# ==========================================
# WhoisXML API key for domain availability checking
# Get your free API key at: https://whoisxmlapi.com/
WHOIS_API_KEY=your_whois_api_key_here

# Flask environment (development or production)
FLASK_ENV=development

# Email configuration for notifications
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# Base URL for email links
BASE_URL=http://localhost:5000

# Security token for subscription processing
SUB_PROCESS_TOKEN=your_secure_random_token_here
